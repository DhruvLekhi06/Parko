# Server
DATABASE_URL=postgres://parko:parko_local_dev@localhost:5432/parko
PORT=3001
CORS_ORIGIN=*
ROUTING_URL=https://router.project-osrm.org
SIM_INTERVAL_MS=4000
ADMIN_KEY=spoton-admin
SESSION_SECRET=change-me-to-a-long-random-string
WELCOME_CREDIT_PAISE=0
# SIM_ENABLED=1 turns on the occupancy simulation (default: on in development, off in production)
# SEED_SYNTHETIC=1 seeds synthetic occupancy + 24h history (default: on in development, off in production)

# Client (Vite reads VITE_* at build time)
VITE_API_URL=
VITE_GOOGLE_MAPS_KEY=
