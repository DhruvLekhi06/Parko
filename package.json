{
  "name": "parko",
  "private": true,
  "version": "0.1.0",
  "description": "SpotOn: smart parking finder for malls and public places (HCI project)",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js --host",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js --reset"
  },
  "dependencies": {
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
